# Copy this file to .env.local and fill in the values.
# For production, also set these in Vercel:
#   Project → Settings → Environment Variables.
# NEXT_PUBLIC_ vars are inlined into the client bundle (public by design).

# Contact form endpoint (Formspree-compatible: accepts a JSON POST).
# e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
